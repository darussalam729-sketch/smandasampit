<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — SMART SMAN 2 Sampit</title>
  <link rel="stylesheet" href="assets/css/style.css">
</head>
<body>
<div class="app">

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="sidebar-logo">
      <div class="logo-icon">S</div>
      <div class="logo-text">
        <div class="app-name">SMART</div>
        <div class="school-name">SMAN 2 SAMPIT</div>
      </div>
    </div>
    <nav>
      <div class="nav-section">
        <div class="nav-label">Utama</div>
        <a class="nav-item active" href="index.html"><span class="ni">⊞</span> Dashboard</a>
        <a class="nav-item" href="jadwal.html"><span class="ni">📅</span> Jadwal</a>
        <a class="nav-item" href="jurnal.html"><span class="ni">📓</span> Jurnal Guru</a>
        <a class="nav-item" href="presensi.html"><span class="ni">✅</span> Presensi <span class="nav-badge">Baru</span></a>
      </div>
      <div class="nav-section">
        <div class="nav-label">KBM &amp; Izin</div>
        <a class="nav-item" href="rekap-kbm.html"><span class="ni">📊</span> Rekap KBM</a>
        <a class="nav-item" href="izin.html"><span class="ni">📝</span> Izin Siswa</a>
        <a class="nav-item" href="surat-izin.html"><span class="ni">🗂️</span> Surat Izin</a>
        <a class="nav-item" href="alokasi.html"><span class="ni">⏱️</span> Alokasi Waktu</a>
      </div>
      <div class="nav-section">
        <div class="nav-label">Layanan Siswa</div>
        <a class="nav-item" href="bk.html"><span class="ni">💙</span> Layanan BK</a>
        <a class="nav-item" href="pembinaan.html"><span class="ni">⚠️</span> Pembinaan BK</a>
        <a class="nav-item" href="walikelas.html"><span class="ni">👩‍🏫</span> Wali Kelas</a>
      </div>
      <div class="nav-section">
        <div class="nav-label">Laporan</div>
        <a class="nav-item" href="laporan.html"><span class="ni">📈</span> Laporan</a>
        <a class="nav-item" href="pengaturan.html"><span class="ni">⚙️</span> Pengaturan</a>
      </div>
    </nav>
    <div class="sidebar-footer">
      <div class="user-info">
        <div class="user-av">KS</div>
        <div>
          <div class="user-name">Kepala Sekolah</div>
          <div class="user-role">Administrator</div>
        </div>
      </div>
    </div>
  </aside>

  <!-- MAIN -->
  <main class="main">

    <!-- HEADER -->
    <header class="header">
      <div style="flex:1">
        <div class="header-title">Dashboard Utama</div>
        <div class="header-sub today-date"></div>
      </div>
      <div class="flex items-center gap-3">
        <span class="badge badge-green">● Sistem Aktif</span>
        <button class="btn-notif" title="Notifikasi">🔔<div class="notif-dot"></div></button>
        <div class="user-chip">
          <div class="chip-av">KS</div>
          <span class="chip-name">Kepala Sekolah</span>
        </div>
      </div>
    </header>

    <!-- CONTENT -->
    <div class="content">

      <!-- STAT CARDS -->
      <div class="stats-grid mb-5">
        <div class="stat-card" onclick="location.href='guru.html'">
          <div class="flex justify-between items-center">
            <div class="stat-icon" style="background:var(--blue-lt)">👨‍🏫</div>
            <span class="trend trend-up">↑ 2</span>
          </div>
          <div class="stat-value" data-count="68">0</div>
          <div class="stat-label">Guru Aktif</div>
          <div class="stat-sub">65 hadir hari ini</div>
        </div>
        <div class="stat-card" onclick="location.href='presensi.html'">
          <div class="flex justify-between items-center">
            <div class="stat-icon" style="background:var(--green-lt)">🎓</div>
            <span class="trend trend-up">↑ 5</span>
          </div>
          <div class="stat-value" data-count="1247">0</div>
          <div class="stat-label">Murid Aktif</div>
          <div class="stat-sub">1.198 hadir hari ini</div>
        </div>
        <div class="stat-card" onclick="location.href='rekap-kbm.html'">
          <div class="flex justify-between items-center">
            <div class="stat-icon" style="background:var(--teal-lt)">📖</div>
            <span class="trend trend-up">92%</span>
          </div>
          <div class="stat-value" data-count="184">0</div>
          <div class="stat-label">KBM Terlaksana</div>
          <div class="stat-sub">Minggu ini · 16 kelas kosong</div>
        </div>
        <div class="stat-card" onclick="location.href='presensi.html'">
          <div class="flex justify-between items-center">
            <div class="stat-icon" style="background:var(--amber-lt)">⏰</div>
            <span class="trend trend-warn">Hari ini</span>
          </div>
          <div class="stat-value" data-count="23">0</div>
          <div class="stat-label">Keterlambatan</div>
          <div class="stat-sub">Siswa + 3 guru piket</div>
        </div>
      </div>

      <!-- CHART + NOTIF -->
      <div class="grid-3-1 mb-5">
        <!-- KBM Chart -->
        <div class="card">
          <div class="card-header">
            <div>
              <div class="card-title">Rekap KBM Mingguan</div>
              <div class="card-sub">Persentase keterlaksanaan KBM per hari</div>
            </div>
            <a class="card-action" href="rekap-kbm.html">Lihat Detail →</a>
          </div>
          <div class="card-body">
            <div class="tabs fit mb-4" data-tabs>
              <button class="tab-btn">Minggu ini</button>
              <button class="tab-btn">Bulan ini</button>
              <button class="tab-btn">Semester</button>
            </div>
            <div class="chart-bars" id="kbm-chart"></div>
            <div class="flex gap-3 mt-4" style="flex-wrap:wrap">
              <div style="display:flex;align-items:center;gap:5px;font-size:11px;color:var(--gray-500)">
                <div style="width:10px;height:10px;border-radius:2px;background:var(--blue)"></div> KBM Guru
              </div>
              <div style="display:flex;align-items:center;gap:5px;font-size:11px;color:var(--gray-500)">
                <div style="width:10px;height:10px;border-radius:2px;background:#93c5fd"></div> Kehadiran Murid
              </div>
            </div>
            <div class="flex gap-3 mt-4">
              <div style="flex:1;background:var(--gray-50);border-radius:8px;padding:10px;text-align:center">
                <div style="font-size:18px;font-weight:800;color:var(--blue)">92%</div>
                <div style="font-size:10px;color:var(--gray-400);margin-top:2px">KBM Tercapai</div>
              </div>
              <div style="flex:1;background:var(--gray-50);border-radius:8px;padding:10px;text-align:center">
                <div style="font-size:18px;font-weight:800;color:var(--green)">96%</div>
                <div style="font-size:10px;color:var(--gray-400);margin-top:2px">Hadir Guru</div>
              </div>
              <div style="flex:1;background:var(--gray-50);border-radius:8px;padding:10px;text-align:center">
                <div style="font-size:18px;font-weight:800;color:var(--amber)">16</div>
                <div style="font-size:10px;color:var(--gray-400);margin-top:2px">Kelas Kosong</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Notifications -->
        <div class="card">
          <div class="card-header">
            <div>
              <div class="card-title">Notifikasi</div>
              <div class="card-sub">5 notifikasi baru</div>
            </div>
            <button class="card-action">Semua →</button>
          </div>
          <div class="card-body" style="padding:10px 18px">
            <div id="notif-list"></div>
          </div>
        </div>
      </div>

      <!-- JADWAL + KEHADIRAN + PROGRESS -->
      <div class="grid-2">
        <!-- Jadwal Hari Ini -->
        <div class="card">
          <div class="card-header">
            <div>
              <div class="card-title">Jadwal Hari Ini</div>
              <div class="card-sub today-date"></div>
            </div>
            <a class="card-action" href="jadwal.html">Lihat Semua →</a>
          </div>
          <div class="table-wrap">
            <table class="data-table" id="jadwal-table">
              <thead>
                <tr>
                  <th>Jam</th>
                  <th>Mata Pelajaran</th>
                  <th>Kelas</th>
                  <th>Guru</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody id="jadwal-tbody"></tbody>
            </table>
          </div>
        </div>

        <!-- Progress JP -->
        <div class="card">
          <div class="card-header">
            <div class="card-title">Progress Alokasi JP</div>
            <div class="card-sub" style="margin-top:2px">Ketercapaian jam pelajaran semester ini</div>
          </div>
          <div class="card-body" id="progress-list"></div>
        </div>
      </div>

    </div><!-- /content -->
  </main>
</div><!-- /app -->

<script src="assets/js/app.js"></script>
<script>
// ── Chart bars ──────────────────────────────────────────
const kbmData = [
  { day:'Sen', guru:72, murid:55 },
  { day:'Sel', guru:90, murid:60 },
  { day:'Rab', guru:78, murid:65 },
  { day:'Kam', guru:85, murid:70 },
  { day:'Jum', guru:40, murid:30 },
  { day:'Sab', guru:55, murid:40 },
];
const chartEl = document.getElementById('kbm-chart');
if (chartEl) {
  chartEl.innerHTML = kbmData.map(d => `
    <div class="bar-col">
      <div class="bar-wrap">
        <div class="bar" style="height:${d.guru}px;background:var(--blue)"></div>
        <div class="bar" style="height:${d.murid}px;background:#93c5fd"></div>
      </div>
      <div class="bar-label">${d.day}</div>
    </div>
  `).join('');
}

// ── Notifications ───────────────────────────────────────
const notifs = [
  { dot:'var(--blue)',   text:'<strong>3 Izin Siswa</strong> menunggu persetujuan guru piket', time:'5 menit lalu', href:'izin.html' },
  { dot:'var(--amber)',  text:'<strong>12 Guru</strong> belum mengisi jurnal mengajar hari ini', time:'30 menit lalu', href:'jurnal.html' },
  { dot:'var(--red)',    text:'<strong>Siti Rahayu</strong> — XII IPA 2 terlambat 3x berturut-turut', time:'1 jam lalu', href:'presensi.html' },
  { dot:'var(--green)',  text:'<strong>Pembinaan BK</strong> dijadwalkan Senin, 25 Mei 2026', time:'2 jam lalu', href:'bk.html' },
  { dot:'var(--purple)', text:'<strong>Laporan Wali Kelas</strong> XI IPS 3 telah diverifikasi', time:'3 jam lalu', href:'walikelas.html' },
];
const notifList = document.getElementById('notif-list');
if (notifList) {
  notifList.innerHTML = notifs.map(n => `
    <div class="notif-item" onclick="location.href='${n.href}'">
      <div class="notif-dot" style="background:${n.dot}"></div>
      <div>
        <div class="notif-text">${n.text}</div>
        <div class="notif-time">${n.time}</div>
      </div>
    </div>
  `).join('');
}

// ── Jadwal table ────────────────────────────────────────
const jadwalData = [
  { jam:'07.00', mapel:'Matematika',   kelas:'XII IPA 1', guru:'Bu Dewi',   status:'hadir',   label:'✓ Berlangsung' },
  { jam:'08.00', mapel:'Biologi',      kelas:'XI IPA 2',  guru:'Pak Rudi',  status:'hadir',   label:'✓ Berlangsung' },
  { jam:'09.00', mapel:'Sejarah',      kelas:'X IPS 3',   guru:'Bu Rina',   status:'amber',   label:'⚠ Pengganti' },
  { jam:'10.30', mapel:'Fisika',       kelas:'XII IPA 3', guru:'Pak Hendra',status:'blue',    label:'◷ Akan datang' },
  { jam:'11.30', mapel:'B. Indonesia', kelas:'XI IPS 1',  guru:'Bu Sari',   status:'blue',    label:'◷ Akan datang' },
];
const jadwalTbody = document.getElementById('jadwal-tbody');
if (jadwalTbody) {
  jadwalTbody.innerHTML = jadwalData.map(r => {
    const cls = r.status === 'hadir' ? 'badge-green' : r.status === 'amber' ? 'badge-amber' : 'badge-blue';
    return `<tr>
      <td style="font-weight:700">${r.jam}</td>
      <td><span class="badge ${cls}" style="font-size:11px">${r.mapel}</span></td>
      <td>${r.kelas}</td>
      <td>${r.guru}</td>
      <td><span class="badge ${cls}">${r.label}</span></td>
    </tr>`;
  }).join('');
}

// ── Progress bars ────────────────────────────────────────
const progData = [
  { name:'Matematika',     pct:87, color:'var(--blue)' },
  { name:'Bahasa Indonesia', pct:92, color:'var(--green)' },
  { name:'Fisika',         pct:74, color:'var(--amber)' },
  { name:'Sejarah',        pct:61, color:'var(--red)' },
  { name:'Biologi',        pct:83, color:'var(--teal)' },
];
const progList = document.getElementById('progress-list');
if (progList) {
  progList.innerHTML = progData.map(p => `
    <div class="prog-item">
      <div class="prog-label">
        <span class="prog-name">${p.name}</span>
        <span class="prog-pct">${p.pct}%</span>
      </div>
      <div class="prog-track">
        <div class="prog-fill" data-pct="${p.pct}" style="width:0%;background:${p.color}"></div>
      </div>
    </div>
  `).join('');
  // trigger animation after inject
  requestAnimationFrame(() => animateProgressBars());
}
</script>
</body>
</html>
